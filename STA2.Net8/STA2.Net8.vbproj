<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>

		<!-- ✅ Correct Startup binding -->
		<StartupObject>STA2.Net8.Startup</StartupObject>	
	</PropertyGroup>

	<!-- ✅ ADD THIS: ensures Startup.vb is compiled -->
	<ItemGroup>
	</ItemGroup>

	<ItemGroup>
		<Import Include="System.Data" />
		<Import Include="System.Drawing" />
		<Import Include="System.Windows.Forms" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Application\Forms\ConfirmInstallerVersionCleanupForm.vb">
			<SubType>Form</SubType>
		</Compile>
		<Compile Update="Application\Forms\EditProgramForm .vb">
			<SubType>Form</SubType>
		</Compile>
		<Compile Update="Application\Forms\FormMain.Designer.vb">
			<SubType>Form</SubType>
		</Compile>
		<Compile Update="Application\Forms\FormMain.vb">
			<SubType>Form</SubType>
		</Compile>
		<Compile Update="Application\Forms\ManageInstallerVersionsForm.vb">
			<SubType>Form</SubType>
		</Compile>
		<Compile Update="Application\Forms\ProgressOverlayForm.vb">
			<SubType>Form</SubType>
		</Compile>
		<Compile Update="Application\Services\ServiceRowControl.vb">
			<SubType>UserControl</SubType>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Application\Docs\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.1" />
		<PackageReference Include="System.Management" Version="10.0.8" />
		<PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.8" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Application\Forms\ConfirmInstallerVersionCleanupForm.resx">
			<SubType>Designer</SubType>
		</EmbeddedResource>
		<EmbeddedResource Update="Application\Forms\EditProgramForm .resx">
			<SubType>Designer</SubType>
		</EmbeddedResource>
		<EmbeddedResource Update="Application\Forms\FormMain.resx">
			<SubType>Designer</SubType>
		</EmbeddedResource>
	</ItemGroup>

</Project>